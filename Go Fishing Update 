-- Helper: Toggle
local function createToggle(text,posY,stateName)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0.45,0,0,18)
    btn.Position = UDim2.new(0.05,0,posY,0)
    btn.Text = text.." OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.BackgroundColor3 = Color3.fromRGB(45,45,65)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,5)
    btn.MouseButton1Click:Connect(function()
        getgenv()[stateName] = not getgenv()[stateName]
        btn.Text = text.." "..(getgenv()[stateName] and "ON" or "OFF")
    end)
end

-- Helper: Box
local function createBox(posY,valueName,default)
    local box = Instance.new("TextBox", Frame)
    box.Size = UDim2.new(0.4,0,0,18)
    box.Position = UDim2.new(0.55,0,posY,0)
    box.Text = tostring(default)
    box.PlaceholderText = "Delay"
    box.Font = Enum.Font.Gotham
    box.TextSize = 10
    box.TextColor3 = Color3.fromRGB(255,255,255)
    box.BackgroundColor3 = Color3.fromRGB(40,40,60)
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,5)
    box.ClearTextOnFocus = false
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then getgenv()[valueName] = n end
        box.Text = tostring(getgenv()[valueName])
    end)
end

-- Toggles
createToggle("Tap",0.2,"AutoTap")
